FROM apache/airflow:2.9.3-python3.11

USER airflow
ENV PATH="/home/airflow/.local/bin:${PATH}"

# Install dbt-postgres adapter and essential pipeline runtime dependencies
RUN pip install --no-cache-dir \
    dbt-core==1.8.2 \
    dbt-postgres==1.8.2 \
    psycopg2-binary==2.9.9 \
    pandas==2.2.2 \
    pyarrow==16.1.0 \
    requests==2.32.3
