# ==============================================================================
# AdCreative Intelligence Platform - Environment Configuration
# ==============================================================================

# PostgreSQL Credentials & Database Settings
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=adcreative_db
POSTGRES_PORT=5432
POSTGRES_HOST=postgres

# API & Dashboard Settings
API_PORT=8000
API_HOST=0.0.0.0

# Standalone Lightweight Airflow Webserver Settings
AIRFLOW_PORT=8088
AIRFLOW_WEB_USER=admin
AIRFLOW_WEB_PASSWORD=admin
AIRFLOW_WEB_EMAIL=admin@adcreative.ai

# Database Connection URL (used inside Docker)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/adcreative_db

# dbt Documentation Server Settings
DBT_DOCS_PORT=8089